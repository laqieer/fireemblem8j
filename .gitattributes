# Auto detect text files and perform LF normalization
* text=auto

*.bin binary

# Committed AIFF sound samples (sound/direct_sound_samples/*.aif) are the source
# of truth for the m4a direct-sound blob (built to raw PCM by tools/aif2pcm).
# Mark binary so no line-ending normalization can corrupt them.
*.aif binary

# Palette files must keep CRLF on checkout to stay byte-identical.
*.pal text eol=crlf

*.sha1 text eol=lf

# carved_rom.tsv is an address-sorted set that gen_layout.py sorts + dedups AND
# overlap-validates, so a union merge of concurrent appends is safe: a genuine
# range overlap aborts gen_layout (and the serial integrator's `make compare`
# rejects the branch) rather than silently miscompiling. Transitional net while
# carves migrate to per-task fragments (layout/carved_rom.d/).
#
# NOT carved_ram.tsv or baseline_syms.tsv: gen_layout does NOT overlap-validate
# them (RAM uses NOLOAD sections linked with --no-check-sections; syms are
# absolute .set), so a bad union there could miscompile silently with no backstop.
# NOT patches.tsv (per-object keyed) or the read-only reference TSVs. For those,
# rely on per-task fragments (no shared-file edit) instead of a merge driver.
layout/carved_rom.tsv    merge=union
