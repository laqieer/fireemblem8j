/tools/ida/*.i64
/tools/ida/*.id0
/tools/ida/*.id1
/tools/ida/*.id2
/tools/ida/*.nam
/tools/ida/*.til
*.i64

# gbadisasm: carve-time disassembler for region-different code (D23). The clone
# + bundled capstone build + the IDA-generated JP config (fe8j_full.cfg) are all
# carve-time only: scripts/carve_gbadisasm_asm.py emits committed `asm/*.s`; the
# build/CI never need gbadisasm. The exporter (scripts/ida/export_gbadisasm_cfg.py)
# + the carver (scripts/carve_gbadisasm_asm.py) are tracked; the tool dir is not.
/tools/gbadisasm

# Ghidra second-opinion decompiler: projects/cache (built locally via
# `make ghidra-db`; the JDK/Ghidra install lives outside the repo).
*.gpr
*.rep/
*_ghidra/
.ghidra/

# objdiff: prebuilt CLI binary (installed locally via
# scripts/tools/objdiff/setup.sh). objdiff.json + the setup script + docs are
# tracked; the vendored binary is not. See docs/tools/objdiff.md.
/tools/objdiff
# coddog cross-binary function-matcher: vendored clone + Rust build artifacts
# (built locally via scripts/tools/coddog/setup.sh). The setup script, configs
# (scripts/tools/coddog/*.coddog.yaml) and docs/tools/coddog.md are tracked.
/tools/coddog
# Throwaway root copies of the coddog configs (the tracked originals live under
# scripts/tools/coddog/; these are copied to the root only to run coddog).
/decomp.yaml
/fe8u.coddog.yaml

# Asset toolchain (Phase 0): gbagfx (graphics + LZ/RL), bin2c (blob->C array),
# preproc (INCBIN_U8 expander). Built locally into the gitignored tools/<tool>/
# from ../fireemblem8u via scripts/tools/<tool>/setup.sh. The setup scripts +
# docs/tools/{gbagfx,bin2c,preproc}.md are tracked; the built binaries are not.
/tools/gbagfx
/tools/bin2c
/tools/preproc

# Sound toolchain (Phase 1 Music): aif2pcm (AIFF -> raw GBA PCM sample) and
# mid2agb (.mid -> m4a song bytecode). Built locally into the gitignored
# tools/<tool>/ from ../fireemblem8u via scripts/tools/<tool>/setup.sh. The setup
# scripts + docs/tools/{aif2pcm,mid2agb}.md are tracked; the binaries are not.
/tools/aif2pcm
/tools/mid2agb

# scaninc (BA1 battle-animation include-dep scanner): built locally into the
# gitignored tools/scaninc/ from pret upstream / ../fireemblem8u via
# scripts/tools/scaninc/setup.sh. The setup script + docs/tools/scaninc.md are
# tracked; the C++ source it stages and the built binary are not.
/tools/scaninc

